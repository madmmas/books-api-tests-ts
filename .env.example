# Copy to .env and adjust. Never commit a real .env.

# Base URL of the API under test (Kong gateway, or the auth service directly)
API_BASE_URL=http://localhost:8080

# Which environment this run targets: local | ci | staging | prod
TEST_ENV=local

# Seeded READ-ONLY account used for the successful-login test.
# It must never be mutated by tests (no failed-attempt or lockout tests against it).
BUYER_USERNAME=buyer@example.com
BUYER_PASSWORD=Password123!

# Set to true to solve and send ALTCHA on login. Off unless explicitly enabled.
ALTCHA_ENABLED=false

# Path that serves the ALTCHA proof-of-work challenge.
# Confirm this with the backend team; it is not in the published OpenAPI spec.
# Only used when ALTCHA_ENABLED=true.
ALTCHA_CHALLENGE_PATH=/auth/altcha/challenge

# Path to the OpenAPI document used for contract checks
OPENAPI_SPEC=./openapi/books-api.yaml
